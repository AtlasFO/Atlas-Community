# secrets
.env
# ... and anything derived from it: a .env.bak copy carries the same keys,
# and the bare `.env` pattern does not match it.
.env.*
!.env.example

# python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# local scratch / backups (never product)
*.tgz
*.tar.gz
/atlas-*.tgz
hub/playbook.assembled.md
claude/CLAUDE.assembled.md
CLAUDE.assembled.md

# maintainer notes, not part of the product
/project-wiki/

# Local runtime — venv stays in-repo; cache/history live under $HOME (XDG)
.venv
.cache/
.atlas_history

# Compat symlink created by install.sh → ~/cases (machine-local absolute target)
/cases

# case outputs — never commit investigation artifacts (root-level only)
/analysis/
/exports/
/reports/
*.log
*.csv
# exclude generated/trace JSON but keep config JSON in the repo
*_trace.json
mft*.json

# OS
.DS_Store

# Keep the committed demo bundle for the installer (overrides the
# *_trace.json / *.log / *.csv ignores above). Evidence is never committed.
!cases/**
cases/**/evidence/

# …but the force-include above also swept in transient, evidence-derived RUN
# OUTPUTS (carved TCP streams, extracted attachments, an .ost store, exports,
# trace backups). These are large binaries — and the forensic tools often write
# them root-owned 0700, so `git add` on them fails with "Permission denied".
# They must never be pushed (evidence-derived). Curated *_trace.json + reports
# stay tracked (already committed; gitignore never un-tracks those).
cases/**/analysis/tcp_streams/
cases/**/analysis/extracted_attachment/
cases/**/analysis/email_attachments/
cases/**/.trace-backups/
cases/**/exports/
cases/**/analysis/*.eml
cases/**/analysis/*.msc
cases/**/analysis/*.jsonl
cases/**/analysis/tool-output/
# Per-case FTS evidence index (core/evidence_index.py) — derived from tool
# output, rebuilt per run, never committed. -wal/-shm are SQLite sidecars.
cases/**/analysis/evidence_index.db*

# Local case runs must not bloat other installs: ignore every case dir under
# the repo `cases/` root. Real investigations live in ~/cases (outside the
# repo); the shipped example bundles live in demo-cases/ and benchmarks/.
# Only the shared reference tables (MITRE) stay tracked here.
cases/*/
!cases/.common/

# Example bundles (demo-cases/ + benchmarks/) keep only
# curated inputs and human-readable deliverables: CASE.md, ground_truth.json,
# reports/*.md, and *_trace.json. Bulk regenerable tool output must never be
# committed — it ballooned the repo when the bundles were relocated here.
**/analysis/http_session*.json
**/analysis/pcap_identity_timeline.json
**/analysis/knowns_patterns.json
**/analysis/*.jsonl
**/analysis/tool-output/
**/analysis/tcp_streams/
**/analysis/evidence_index.db*

# Regression-gate baseline traces (tests/regression/baselines.json) — curated,
# small, and must stay tracked despite the global *_trace.json ignore above.
!benchmarks/batman/analysis/BATMAN-I_trace.json
!benchmarks/cfreds-leak/analysis/CFREDS-LEAK_trace.json
!demo-cases/DEMO-LIVE/analysis/DEMO-LIVE_INV-001_trace.json
# Demo bundle traces the dashboard's --demo view opens.
!demo-cases/DEMO-LIVE/analysis/DEMO-LIVE_INV-002_trace.json
!demo-cases/m57-jean/analysis/M57-JEAN_trace.json
!demo-cases/rhino-hunt/analysis/RHINO-HUNT_trace.json

# Second brain local private context
brain/AGENTS.local.md

# Second brain analytics snapshots: date-stamped time series written by every
# `atlas brain stats` run — local data for `brain report`, never committed
# (a new file appears each day and would perpetually dirty the tree).
brain/analytics/snapshots/*.json
# Brain Earth data: regenerated by `atlas brain globe` with a wall-clock stamp
# and day-dependent recency — local artifact for the dashboard, not tracked.
brain/analytics/globe/brain-globe.json

# Second brain: raw per-run captures generated by using Atlas (case learnings,
# run logs, deliverables, housekeeping reports). Not product code — every
# install grows its own; never commit these. .gitignore-public lists the
# same paths for `atlas publish`.
brain/inbox/
brain/logs/runs/
brain/analytics/deliverables/
brain/analytics/reports/
brain/wiki/cases/
brain/wiki/environments/
brain/memory/
brain/issue/
brain/CONTRIBUTORS


# Accidental mock/test case dirs (broken case_dir resolution artifacts)
/MagicMock/
sansforensics.zip

# Per-case runtime state. Atlas writes .atlas/ into whatever case dir it is
# pointed at — including the shipped template and demo bundles when a run,
# a prompt build or a test happens to touch them. It is regenerated on
# demand and is never part of the shipped tree.
**/.atlas/
# One curated exception: the rhino-hunt demo ships its finished run's state
# (claim graph, questions, report projection), so --demo shows every tab and
# not only the trace. Browsing a case in the dashboard writes nothing into it.
!demo-cases/rhino-hunt/.atlas/
**/analysis/brain_injection.json

# Run exports copied off a host (claim graph, traces, reports) — never part
# of the repository.
/RunData/

# Generated validation reports (devtools/validation/run.py).
devtools/validation/reports/*.json

# Local list of terms the pre-commit hook refuses to commit. The list itself
# must never ship.
.git-private-terms

# Local assistant session state (worktrees, settings); never part of the product.
/.claude/

# Live-test run reports are written by every run; only the folder is kept.
tests/live/reports/*
!tests/live/reports/.gitkeep
# Provider probes keep raw replies local; parser fixtures are written by hand.
devtools/llm_shapes/fixtures/
devtools/llm_shapes/*.jsonl
devtools/llm_shapes/smoke_compat.json

# Community edition: development tools and your own brain notes
/devtools/
/brain/wiki/**/*.md
/brain/logs/**/*.md
/brain/indexes/*.md
