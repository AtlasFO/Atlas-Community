#!/usr/bin/env bash
# Manage Atlas API keys in the GNOME Keyring (service: atlas-sift).
#
# Usage:
#   atlas-secret set REASON_API_KEY        # prompts for the value (visible input)
#   atlas-secret set --env REASON_API_KEY  # write to .env instead of the keyring
#   atlas-secret get REASON_API_KEY        # prints the stored value (careful — visible on screen)
#   atlas-secret clear REASON_API_KEY      # removes it
#   atlas-secret list                      # shows which managed keys are currently stored
#
# --env exists for hosts with no Secret Service (no gnome-keyring daemon, e.g. a
# headless VM). It is a separate, explicit flag rather than an automatic fallback:
# writing a credential to a plaintext file is a different security decision than
# storing it in a keyring, and a tool must not make that decision silently.
set -euo pipefail

SERVICE="atlas-sift"
MANAGED_KEYS=(REASON_API_KEY DAIR_API_KEY ANTHROPIC_API_KEY VIRUSTOTAL_API_KEY ABUSEIPDB_API_KEY OTX_API_KEY URLSCAN_API_KEY MISP_URL MISP_API_KEY LLMHUB_API_KEY TSYSTEMS_API_KEY)

# `list` also covers the API key of every provider named in ATLAS_PROVIDERS, so a
# gateway token stored here is not invisible to it. set/get/clear already accept
# any key name. ATLAS_PROVIDERS is read from the environment or, failing that,
# from the repo's .env — this script does not import the Python config loader.
if [[ -z "${ATLAS_PROVIDERS:-}" && -f "$(dirname "$0")/../.env" ]]; then
    ATLAS_PROVIDERS="$(sed -n 's/^[[:space:]]*ATLAS_PROVIDERS[[:space:]]*=//p' \
        "$(dirname "$0")/../.env" | tail -1 | tr -d '"'"'"' \t\r')"
fi
if [[ -n "${ATLAS_PROVIDERS:-}" ]]; then
    while IFS= read -r name; do
        [[ -z "$name" || "$name" == "llmhub" ]] && continue
        infix="$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')"
        MANAGED_KEYS+=("ATLAS_PROVIDER_${infix}_API_KEY")
    done < <(printf '%s' "$ATLAS_PROVIDERS" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
fi

# Only the keyring paths (set without --env, get, clear, list) need
# secret-tool — `set --env` writes straight to .env and never touches it.
# A single unconditional check at the top of the script would make
# `set --env` (exactly what install.sh's optional-API-key wizard calls) fail
# before ever reaching the value prompt on any host without libsecret-tools
# installed (e.g. a bare distrobox). Checked lazily at each call site
# instead.
_require_secret_tool() {
    if ! command -v secret-tool >/dev/null 2>&1; then
        echo "secret-tool not found. Install it with: sudo apt-get install libsecret-tools" >&2
        exit 1
    fi
}

cmd="${1:-}"
key="${2:-}"

case "$cmd" in
    set)
        use_env=0
        if [[ "$key" == "--env" ]]; then
            use_env=1
            key="${3:-}"
        fi
        if [[ -z "$key" ]]; then
            echo "Usage: atlas-secret set [--env] <KEY_NAME>" >&2
            exit 1
        fi
        # Visible, not -s: a hidden prompt with zero feedback made it
        # impossible to tell whether a paste landed at all (found via a
        # real install — someone pasting a VirusTotal key had no way to
        # confirm anything happened). These are API keys pasted into a
        # local terminal during setup, not passwords typed character by
        # character — `atlas-secret get` already prints them in plaintext
        # too, so hiding entry only bought inconvenience, not real secrecy.
        read -r -p "Value for $key: " value
        if [[ -z "$value" ]]; then
            echo "Empty value — aborted." >&2
            exit 1
        fi
        if [[ "$use_env" -eq 0 ]]; then
            _require_secret_tool
            if printf '%s' "$value" | secret-tool store --label="Atlas $key" service "$SERVICE" key "$key"; then
                echo "Stored $key in GNOME Keyring (service=$SERVICE)."
            else
                echo "Keyring write failed — this host has no Secret Service." >&2
                echo "To put it in .env instead (plaintext file, not a keyring):" >&2
                echo "  $0 set --env $key" >&2
                exit 1
            fi
            exit 0
        fi

        # .env branch. Resolve symlinks: a git worktree usually links its .env at
        # the primary checkout, and writing through the link must land in the one
        # real file rather than replacing the link with a copy.
        env_file="$(cd "$(dirname "$0")/.." && pwd)/.env"
        env_file="$(readlink -f "$env_file" 2>/dev/null || printf '%s' "$env_file")"
        if [[ ! -f "$env_file" ]]; then
            echo "No .env at $env_file — create it first." >&2
            exit 1
        fi
        tmp="$(mktemp)"
        chmod 600 "$tmp"
        trap 'rm -f "$tmp"' EXIT
        # Rewrite line-by-line in the shell: passing the value to sed or awk
        # would expose it in the process arguments, readable via ps and /proc.
        found=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^[[:space:]]*#?[[:space:]]*"$key"= ]]; then
                if [[ "$found" -eq 0 ]]; then
                    printf '%s=%s\n' "$key" "$value" >> "$tmp"
                    found=1
                fi   # any further copies of the same key are dropped
            else
                printf '%s\n' "$line" >> "$tmp"
            fi
        done < "$env_file"
        if [[ "$found" -eq 0 ]]; then
            printf '%s=%s\n' "$key" "$value" >> "$tmp"
        fi
        # cat, not mv: keeps the original inode, owner and mode, so the symlink
        # from other worktrees keeps pointing at the same file.
        cat "$tmp" > "$env_file"
        if grep -qE "^${key}=.+" "$env_file"; then
            echo "Wrote $key to $env_file"
            echo "  mode $(stat -c %a "$env_file" 2>/dev/null || echo '?') — a plaintext file, not a keyring."
            echo "  Verified present and non-empty."
        else
            echo "Verification failed — $key is not present in $env_file." >&2
            exit 1
        fi
        ;;
    get)
        if [[ -z "$key" ]]; then
            echo "Usage: atlas-secret get <KEY_NAME>" >&2
            exit 1
        fi
        _require_secret_tool
        secret-tool lookup service "$SERVICE" key "$key"
        ;;
    clear)
        if [[ -z "$key" ]]; then
            echo "Usage: atlas-secret clear <KEY_NAME>" >&2
            exit 1
        fi
        _require_secret_tool
        secret-tool clear service "$SERVICE" key "$key"
        echo "Cleared $key."
        ;;
    list)
        _require_secret_tool
        echo "Managed keys and keyring status (service=$SERVICE):"
        for k in "${MANAGED_KEYS[@]}"; do
            if secret-tool lookup service "$SERVICE" key "$k" >/dev/null 2>&1; then
                echo "  $k: stored"
            else
                echo "  $k: (not set)"
            fi
        done
        ;;
    -h|--help|help)
        echo "Usage: atlas-secret {set [--env]|get|clear|list} [KEY_NAME]"
        echo "  set    store a key in the OS keyring (--env: write .env instead)"
        echo "  get    print a stored key"
        echo "  clear  remove a stored key"
        echo "  list   which managed keys are stored"
        ;;
    *)
        echo "Usage: atlas-secret {set [--env]|get|clear|list} [KEY_NAME]" >&2
        exit 1
        ;;
esac
