name: Custom.Atlas.WinNewNetwork
description: |
  Atlas-managed (Windows): detect new outbound connections to non-RFC1918
  destinations whose (ip, port) pair is not in the baseline allowlist.

  Primary source is Sysmon Event ID 3 (Network Connect) from the
  Microsoft-Windows-Sysmon/Operational channel via watch_evtx. Falls back to
  periodic Netstat polling when Sysmon is absent.

  Requires: sysmon (for the real-time source).

type: CLIENT_EVENT

parameters:
  - name: BaselineEndpointPairs
    description: JSON array of "ip:port" pairs considered known-good.
    default: |
      ${baseline_endpoints_dst_pairs}
  - name: SysmonChannel
    description: Sysmon operational event-log channel.
    default: Microsoft-Windows-Sysmon/Operational
  - name: PollSeconds
    description: Poll interval for the fallback Netstat source.
    type: int
    default: 10

sources:
  - name: SysmonNetworkConnect
    query: |
      LET baseline <= parse_json_array(data=BaselineEndpointPairs)
      SELECT
        System.TimeCreated.SystemTime AS timestamp_utc,
        EventData.SourceIp AS local_ip,
        atoi(string=EventData.SourcePort) AS local_port,
        EventData.DestinationIp AS remote_ip,
        atoi(string=EventData.DestinationPort) AS remote_port,
        EventData.Image AS image_path,
        atoi(string=EventData.ProcessId) AS Pid
      FROM watch_evtx(filename=SysmonChannel, accessor="event_log")
      WHERE System.EventID.Value = 3
        AND NOT remote_ip =~ "^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.|127\\.|0\\.|169\\.254\\.|::1|fe80:)"
        AND remote_port > 0
        AND NOT (format(format="%s:%d", args=[remote_ip, remote_port])) IN baseline

  - name: PollFallback
    query: |
      LET baseline <= parse_json_array(data=BaselineEndpointPairs)
      LET tick = SELECT * FROM clock(period=PollSeconds)
      LET snapshot = SELECT
        timestamp(epoch=now()) AS timestamp_utc,
        Laddr.IP AS local_ip,
        Laddr.Port AS local_port,
        Raddr.IP AS remote_ip,
        Raddr.Port AS remote_port,
        Pid
      FROM Artifact.Windows.Network.Netstat()
      WHERE NOT Raddr.IP =~ "^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.|127\\.|0\\.|169\\.254\\.|::1|fe80:)"
        AND Raddr.Port > 0
        AND NOT (format(format="%s:%d", args=[Raddr.IP, Raddr.Port])) IN baseline
        AND Status = "ESTABLISHED"
      SELECT * FROM foreach(row=tick, query=snapshot)
