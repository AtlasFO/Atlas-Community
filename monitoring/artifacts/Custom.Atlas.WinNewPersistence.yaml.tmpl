name: Custom.Atlas.WinNewPersistence
description: |
  Atlas-managed (Windows): watch the registry autorun + scheduled-task
  persistence surface for new entries. Emits a row whenever a value appears in
  a watched key/path that is not in the baseline allowlist.

  Implemented as a periodic snapshot-diff over WIN_PERSISTENCE_SURFACE (the same
  set the WinPersistenceSnapshot baseline helper enumerates), so the allowlist
  can never drift from what the detector watches — the same design as the Linux
  NewPersistence detector. A real-time alternative is Sysmon EID 12/13
  (registry value set) + Security EID 4698 (scheduled task created); the poll
  approach is used here because it needs no Sysmon registry-audit config and
  matches the snapshot surface exactly.

type: CLIENT_EVENT

parameters:
  - name: BaselinePersistencePaths
    description: JSON array of persistence entry paths considered known-good.
    default: |
      ${baseline_persistence_paths}
  - name: WatchKeys
    description: |
      JSON array of registry-key / file globs to walk every poll cycle,
      substituted from monitoring/render.py:WIN_PERSISTENCE_SURFACE so the
      baseline snapshot walks the identical set.
    default: |
      ${win_watch_keys}
  - name: PollSeconds
    description: How often to re-walk the watched surface.
    type: int
    default: 15

sources:
  - query: |
      LET baseline <= parse_json_array(data=BaselinePersistencePaths)
      LET watch <= parse_json_array(data=WatchKeys)
      LET tick = SELECT * FROM clock(period=PollSeconds)
      SELECT
        timestamp(epoch=now()) AS timestamp_utc,
        FullPath AS path,
        Data.value AS value,
        Mtime AS mtime_utc
      FROM foreach(
        row=tick,
        query={
          SELECT FullPath, Data, Mtime
          FROM glob(globs=watch, accessor="auto")
          WHERE NOT FullPath IN baseline
        })
