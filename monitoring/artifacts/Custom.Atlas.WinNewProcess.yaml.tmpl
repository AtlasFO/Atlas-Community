name: Custom.Atlas.WinNewProcess
description: |
  Atlas-managed (Windows): emit a row for any process image not in the
  operator-provided baseline.

  Primary source is Sysmon Event ID 1 (Process Create) tailed from the
  Microsoft-Windows-Sysmon/Operational channel via watch_evtx — this gives
  real-time creation events with the SHA256 hash (used by the FirstSeenBinary
  behavior rule). If Sysmon is not installed the operator should fall back to
  the poll source below (periodic Pslist), which has a poll-interval blind spot
  for short-lived processes and no hash.

  Requires: sysmon (for the real-time source).

type: CLIENT_EVENT

parameters:
  - name: BaselineImagePaths
    description: JSON array of image paths considered known-good.
    default: |
      ${baseline_image_paths}
  - name: BaselineProcessNames
    description: JSON array of process basenames considered known-good.
    default: |
      ${baseline_proc_names}
  - name: SysmonChannel
    description: Sysmon operational event-log channel.
    default: Microsoft-Windows-Sysmon/Operational
  - name: PollSeconds
    description: Poll interval for the fallback Pslist source.
    type: int
    default: 5

sources:
  - name: SysmonProcessCreate
    query: |
      LET baseline_paths <= parse_json_array(data=BaselineImagePaths)
      LET baseline_names <= parse_json_array(data=BaselineProcessNames)
      SELECT
        System.TimeCreated.SystemTime AS timestamp_utc,
        EventData.Image AS image_path,
        basename(path=EventData.Image) AS process_name,
        atoi(string=EventData.ProcessId) AS pid,
        EventData.ParentImage AS parent_image,
        EventData.CommandLine AS commandline,
        EventData.User AS username,
        regex_replace(source=EventData.Hashes, re=".*SHA256=([0-9A-Fa-f]+).*", replace="$1") AS sha256,
        EventData.UtcTime AS started_utc
      FROM watch_evtx(filename=SysmonChannel, accessor="event_log")
      WHERE System.EventID.Value = 1
        AND NOT image_path IN baseline_paths
        AND NOT process_name IN baseline_names
        AND image_path != ""

  - name: PollFallback
    query: |
      LET baseline_paths <= parse_json_array(data=BaselineImagePaths)
      LET baseline_names <= parse_json_array(data=BaselineProcessNames)
      LET tick = SELECT * FROM clock(period=PollSeconds)
      SELECT * FROM foreach(row=tick, query={
        SELECT
          timestamp(epoch=now()) AS timestamp_utc,
          Exe AS image_path,
          Name AS process_name,
          Pid AS pid,
          CommandLine AS commandline,
          Username AS username,
          "" AS sha256,
          CreateTime AS started_utc
        FROM Artifact.Windows.System.Pslist()
        WHERE NOT Exe IN baseline_paths
          AND NOT Name IN baseline_names
          AND Exe != ""
      })
