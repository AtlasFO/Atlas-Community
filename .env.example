# Atlas MCP Server — environment configuration
#
# Prefer the interactive wizard over hand-editing this file:
#   bin/atlas provider setup
# (or the dashboard's Settings page). It writes exactly the vars below for
# whichever LLM backend you pick — see docs/llm.md for the full manual
# reference, rate limits, and context-window auto-probe details.

# ── IOC Enrichment (optional — server degrades gracefully without these) ──
# bin/atlas-secret set --env <KEY>, install.sh's own wizard step, or the
# dashboard's Settings page (Enrichment keys) can all set these instead.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# AlienVault OTX
OTX_API_KEY=
# urlscan.io
URLSCAN_API_KEY=
# your own MISP instance, if you run one
MISP_URL=
# pairs with MISP_URL
MISP_API_KEY=

# ── LLM provider — pick exactly one backend ────────────────────────────────
# All three model roles (analyst, reason.*, dair.*) share this config unless
# overridden per-role below. A working provider is required for full-quality
# results.

# No provider is selected until you run `bin/atlas provider setup` or the
# dashboard's Settings page. Telekom LLM Hub is one available choice — it is
# not assumed. Uncomment (or let the wizard write) these when you pick it:
# LLMHUB_BASE_URL=https://llm-server.llmhub.t-systems.net/v2
# LLMHUB_API_KEY=
# LLMHUB_MODEL=GLM-5.2
# ATLAS_AGENT_PROVIDER=llmhub
# REASON_BACKEND=llmhub
# DAIR_BACKEND=llmhub
# ATLAS_AGENT_MODEL=                      # analyst-only override

# OpenAI-compatible endpoint (OpenAI itself, local vLLM/Ollama/LM Studio, or
# any other gateway) — an equally-supported alternative to the hub above.
# REASON_BACKEND=openai-compat
# REASON_URL=https://api.openai.com/v1        # or http://localhost:8000 for local vLLM
# REASON_API_KEY=sk-...                        # OpenAI key, HF token, or blank for local
# REASON_MODEL=gpt-4o-mini                     # or fdtn-ai/Foundation-Sec-8B-Reasoning
# DAIR_BACKEND=openai-compat
# DAIR_URL=http://localhost:8001               # separate from REASON_URL, or the same
# DAIR_API_KEY=hf_...
# DAIR_MODEL=fdtn-ai/Foundation-Sec-8B-Reasoning
#
# Deprecated aliases still work: FOUNDATION_SEC_URL→REASON_URL, HF_TOKEN→REASON_API_KEY.

# ── Advanced: agent/context tuning (optional, applies to any backend) ─────
# See docs/llm.md's "Rate limits" / "Model context auto-probe" sections.
# ATLAS_AGENT_INPUT_TPM=400000            # pace below the backend's input TPM cap (0 = off)
# ATLAS_AGENT_RATE_LIMIT_WAIT=600         # max total seconds to wait out HTTP 429s
# ATLAS_AGENT_CONTEXT_CHARS=3000000       # derived from the probed window (1M × 0.75 × 4); set only to pin
# ATLAS_AGENT_MAX_OPENAI_TOOLS=128        # ceiling on tool schemas per request; a lower working size is learned per model
# ATLAS_MODEL_CONTEXT_PROBE=1             # 0 = disable the live context-window probe
# ATLAS_MODEL_CONTEXT_TOKENS=1000000      # recommended GLM-5.2 window; hard override (skips the probe)
# ATLAS_CONTEXT_AUTO_CHARS=1              # grow *and* shrink AGENT_CONTEXT_CHARS to fit the window
# ATLAS_CONTEXT_CHARS_LOCK=0              # 1 = never auto-move AGENT_CONTEXT_CHARS
# ATLAS_PROVIDER_<NAME>_API=chat          # chat (default) or responses — per provider only
# ATLAS_FINDING_AUTO_DOWNGRADE=1          # CONFIRMED→LIKELY/SUSPECTED when evaluate/cite ritual missing
# ATLAS_CHAT_MAX_TOOL_ROUNDS=0            # dashboard/`atlas chat` tool rounds per message (0 = unlimited)
# LLMHUB_THINKING=auto                    # how hard the hub provider's models think: auto|low|medium|high
# ATLAS_PROVIDER_<NAME>_THINKING=auto     # the same for any other provider; auto learns a level from an empty reply
# ATLAS_LLM_MAX_OUTPUT_TOKENS=            # optional global completion ceiling; none is sent by default
# ATLAS_EFFORT_<ROLE>=low                 # advanced: per-role override of the provider setting, one of low | medium |
#                                         # high | default (the endpoint's own, chosen on purpose). Roles: AGENT, REPORT,
#                                         # DAIR, PLAN, HYPOTHESIZE, EVALUATE_FINDING, CITE_CHECK, CONFIDENCE_SCORE,
#                                         # AUDIT_FINDINGS, SYNTHESIZE. The three lookup roles (CITE_CHECK,
#                                         # CONFIDENCE_SCORE, EVALUATE_FINDING) default to low, every other role to the
#                                         # provider's Thinking setting. None is required to start a run.
#                                         # Settings -> Providers -> Thinking levels sets them.
# ATLAS_DAIR_REUSE_STANDING=1             # 0 = consult the director on every dair_assess, even on an unchanged state

# ── Tool execution timeouts (seconds) ──────────────────────────────────────
# Tuned for Hub reasoning models on WSL2. Lower for faster/cheaper models.
# most tools (regripper, yara, strings, etc.)
ATLAS_DEFAULT_TIMEOUT=600
# vol plugins, hashing dirs, heavy sleuthkit ops
ATLAS_VOL_TIMEOUT=1800
# full disk timeline (6 hours)
ATLAS_PLASO_TIMEOUT=21600
# reasoning backend HTTP call
ATLAS_REASON_TIMEOUT=600
# DAIR director
ATLAS_DAIR_TIMEOUT=600
# one report-section model call; past it the section is written deterministically and marked
ATLAS_REPORT_SECTION_TIMEOUT=900

# ── Disk-space fail-safe ─────────────────────────────────────────────────────
# Atlas refuses to launch a tool/job when the target volume is below the
# floor, and the background-job watchdog aborts a job that fills the disk
# mid-run. The floor is whichever is LARGER: the absolute MB, or the percent.
# block/abort when free space drops below 2 GiB…
ATLAS_MIN_FREE_DISK_MB=2048
# …or below 2% of the volume, whichever is larger
ATLAS_MIN_FREE_DISK_PCT=2

# ── Dashboard listen (optional) ─────────────────────────────────────────────
# Default is localhost HTTP. install.sh --with-dashboard-lan writes
# ATLAS_DASHBOARD_BIND=0.0.0.0 (HTTPS on all interfaces). First browser
# visit still creates the admin account. Atlas does not open the firewall.
# ATLAS_DASHBOARD_BIND=127.0.0.1
# ATLAS_DASHBOARD_PORT=8765
# ATLAS_DASHBOARD_EXTRA_HOSTS=           # extra Host names (reverse proxy DNS)
# Mail the outcome when a run ends (needs the SMTP settings above / the
# dashboard's Settings -> Mail). A run started from the dashboard is announced by the
# dashboard to whoever pressed Start, so this is for terminal runs.
# ATLAS_RUN_NOTIFY_EMAIL=you@example.com

# Dashboard session limits (Settings -> Sign-in and sessions writes these).
# A user is logged out after this many hours without a request, and in any
# case this many hours after signing in. Read per request, so a change takes
# effect immediately; a malformed value falls back to the default.
# ATLAS_SESSION_IDLE_HOURS=12
# ATLAS_SESSION_MAX_HOURS=168

# WATCHFILES_FORCE_POLLING=1             # cases root on a network share (no inotify):
#                                        # the live change stream polls instead
# Org TLS drop-in (no UI) — first match wins:
#   1. ATLAS_DASHBOARD_TLS_CERT + ATLAS_DASHBOARD_TLS_KEY
#   2. /etc/atlas/dashboard/tls.crt + tls.key   (mode 0600 on the key)
#   3. ~/.config/atlas/dashboard/tls/cert.pem + key.pem
# A self-signed cert is minted into (3) only when BIND is not loopback and
# nothing above exists. After replacing files: sudo systemctl restart atlas-dashboard
# ATLAS_DASHBOARD_TLS_CERT=
# ATLAS_DASHBOARD_TLS_KEY=

# Usage ledger: one row per model request of every role, read by
# Settings -> Token spend. Absolute path; default ~/.config/atlas/usage.db
# ATLAS_USAGE_DB=

# Volatility 3 symbol cache — must be writable by the current user.
# Default: ~/.cache/volatility3/symbols (auto-created)
VOLATILITY_SYMBOLS=
