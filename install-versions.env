# install-versions.env — single source of truth for every pinned external
# tool install.sh provisions. Sourced directly by install.sh (plain
# bash KEY=VALUE, no parser dependency needed on the target machine).
#
# When bumping a value here, the docker-compat CI job (see
# .github/workflows/docker-compat.yml) must pass before merging — a pin
# bump is exactly the kind of change that needs the Ubuntu 24.04 + Debian 12
# install+smoke-test gate, not just a diff review.
#
# Rollback is just reverting the line that changed — every value below is
# an exact pin (a version, or a commit SHA), never a floating branch/latest.

# GitHub-release binaries — exact release version, no 'v' prefix.
CHAINSAW_VERSION=2.10.2
HAYABUSA_VERSION=4.0.0
# Detect It Easy (github.com/horsicq/DIE-engine): packer/compiler/
# protector identification. Upstream ships a .deb per distribution
# release, named die_<version>_<Distro>_<Release>_amd64.deb, so the
# install step builds the asset name from /etc/os-release. Optional:
# no distribution packages it, and misc.pe_scanner covers packing
# heuristics without it.
DIE_VERSION=3.21

# RegRipper4.0 (github.com/keydet89/RegRipper4.0) ships no tags/releases —
# only a rolling `main` branch — so the only real pin available is an exact
# commit SHA. install.sh fetches this SHA directly (works against GitHub's
# shallow-fetch-by-SHA support), not `main`'s tip.
REGRIPPER_REF=f925c0965db202eed46071b3e68f6d3a49b41a31

# Velociraptor client binary (github.com/Velocidex/velociraptor): the
# velo.* tools need it plus an operator-issued API config. Optional.
VELOCIRAPTOR_VERSION=0.77.2

# jphs (github.com/h3xx/jphs): jphide/jpseek, JPEG steganography. No
# releases exist, so the pin is an exact commit SHA of master.
JPHS_REF=33a11e1bad146f5e9c0d3fe6475812a1cedb9b7e

# odl.py (github.com/ydkhatri/OneDrive, MIT): the OneDrive sync-log reader
# behind misc.onedrive_odl. No releases exist; the pin is an exact commit
# SHA, which install.sh checks with git rev-parse after checkout.
ODL_REF=9ad135ecf56cd2086256cf8440b98b5eaa50c0ab

# INDXParse (github.com/williballenthin/INDXParse, Apache-2.0): $I30 index
# parsing behind tsk.tsk_indxparse. Not on PyPI; pip installs this exact
# commit into the venv, and install.sh compares it with the commit_id pip
# records in the distribution's direct_url.json.
INDXPARSE_REF=038e8ec836cf23600124db74b40757b7184c08c5

# EZ Tools (Eric Zimmerman's Windows artifact parsers) — NOT PINNABLE today.
# download.mikestammer.com/net9/<Tool>.zip carries no version segment at
# all; it always serves whatever the mirror currently hosts (this is the
# same URL scheme that already broke once: the net6 zips it used to serve
# 404 now). There is no upstream signal a scheduled check can compare
# against, so this dependency is covered by the *scheduled* (not just
# PR-triggered) docker-compat run instead of a version pin — that run is
# the only thing that can catch a silent break here, since nothing in this
# repo needs to change for the mirror's content to change.
